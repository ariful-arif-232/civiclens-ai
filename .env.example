# Local demo only: npm run demo:setup (never deploy local JSON mode to Vercel).
DEMO_MODE=false
# Neon connection string. Existing project: civiclens-ai, Singapore. Server only.
DATABASE_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# Required for protected authority writes and privacy-preserving rate limits.
ADMIN_TOKEN=
# Set true ONLY after confirming all accounts/key/model are on free tiers.
FREE_TIER_CONFIRMED=false
# Conservative app quota, NOT a guarantee about provider billing. Two AI calls max/report.
MAX_REPORTS_PER_DAY=20
