{
  "name": "civiclens-ai",
  "version": "1.0.0",
  "description": "CivicLens AI: from citizen reports to actionable infrastructure intelligence",
  "main": "index.js",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts && npm run test:transports",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "test:integration": "node scripts/integration.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "demo:setup": "node scripts/setup-demo.mjs",
    "test:transports": "node --test tests/integrations.test.mjs",
    "db:verify": "node --env-file-if-exists=.env.local scripts/db.mjs verify",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/db.mjs migrate",
    "preflight": "node --env-file-if-exists=.env.local scripts/preflight.mjs",
    "test:live": "node --env-file-if-exists=.env.local scripts/verify-live.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "lucide-react": "1.47.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "prettier": "3.9.8",
    "supabase": "2.117.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=22.0.0 <25"
  }
}
